# Cabeceras para Cloudflare Pages · REVU 1910
# La primera regla que coincide con la ruta es la que manda.

# ---------------------------------------------------------------
# Todo el sitio: cabeceras de seguridad razonables
# ---------------------------------------------------------------
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

# ---------------------------------------------------------------
# Hoja de estilos y código: caché larga.
# Es seguro porque index.html los pide con ?v=N; al subir ese número
# el navegador los ve como archivos distintos y los vuelve a bajar.
# ---------------------------------------------------------------
/styles.css
  Cache-Control: public, max-age=31536000, immutable

/app.js
  Cache-Control: public, max-age=31536000, immutable

# ---------------------------------------------------------------
# Imágenes: una semana.
# No se pone caché eterna a propósito: varias veces hemos cambiado
# el contenido de hero.jpg o logo-marca.png conservando el nombre.
# Si reemplazas una foto y quieres verla ya, en Cloudflare entra a
# Caching -> Configuration -> Purge Everything.
# ---------------------------------------------------------------
/images/*
  Cache-Control: public, max-age=604800

# ---------------------------------------------------------------
# HTML: sin caché larga, para que los cambios se vean al instante.
# ---------------------------------------------------------------
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# ---------------------------------------------------------------
# Archivos para buscadores: se revisan a diario
# ---------------------------------------------------------------
/sitemap.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400
